{
  "id": "/?app=community",
  "name": "Community",
  "short_name": "Community",
  "description": "Plateforme de sondage interactif pour créer des votes, recueillir des avis, animer une communauté et suivre les résultats en temps réel.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/browse-surveys.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "theme_color": "#6366f1",
  "background_color": "#0f172a",
  "prefer_related_applications": false,
